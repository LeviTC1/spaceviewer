# SpaceViewer frontend — all settings optional; runs with zero config.

# Base URL for the backend API (default: /api, proxied to localhost:3001 by the Vite dev server).
# Set this when the backend is deployed on a different origin.
# VITE_API_URL=https://your-backend.example.com/api

# Optional URL for the separately deployed EarthViewer surface. In development
# SpaceViewer defaults this to http://localhost:5175/.
# VITE_EARTH_VIEWER_URL=https://earth.example.com/
